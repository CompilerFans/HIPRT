#pragma once

#define HIPRT_MAJOR_VERSION @HIPRT_MAJOR_VERSION@
#define HIPRT_MINOR_VERSION @HIPRT_MINOR_VERSION@
#define HIPRT_PATCH_VERSION @HIPRT_PATCH_VERSION@
#define HIPRT_HASH_VERSION @HIPRT_HASH_VERSION@

#define HIPRT_API_VERSION @HIPRT_API_VERSION@
#define HIPRT_VERSION_STR @HIPRT_VERSION_STR@
#define HIP_VERSION_STR @HIP_VERSION_STR@

#include <hiprt/hiprt.h>

#ifdef __cplusplus
extern "C" {
#endif

enum
{
	HIPRTEW_SUCCESS				= 0,
	HIPRTEW_ERROR_OPEN_FAILED	= -1,
	HIPRTEW_ERROR_ATEXIT_FAILED = -2,
	HIPRTEW_ERROR_OLD_DRIVER	= -3,
	HIPRTEW_NOT_INITIALIZED		= -4,
};

static inline void hiprtewInit( int* resultDriver )
{
	if ( resultDriver != nullptr ) *resultDriver = HIPRTEW_SUCCESS;
}

#ifdef __cplusplus
}
#endif
