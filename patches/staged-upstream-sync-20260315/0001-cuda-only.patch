-  unsigned int e = oroStreamSynchronize(streamToRun);
-#else
-  //  non stream version, works
-  oroModuleLaunchKernel(kernel, grid.x, grid.y, grid.z, block.x, block.y, block.z, 0, (oroStream)0, args, 0);
-  unsigned int e = oroCtxSynchronize();
-#endif
-  e += 0;
-}
