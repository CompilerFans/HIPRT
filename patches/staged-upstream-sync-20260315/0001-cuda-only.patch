-			if(flags & FE_UNDERFLOW)
-				throw std::underflow_error(HALF_ERRHANDLING_THROW_UNDERFLOW);
-		#endif
-		#ifdef HALF_ERRHANDLING_THROW_INEXACT
-			if(flags & FE_INEXACT)
