-			raise(FE_OVERFLOW);
-		#endif
-			return	(R==std::round_toward_infinity) ? (sign+0x7C00-(sign>>15)) :
-					(R==std::round_toward_neg_infinity) ? (sign+0x7BFF+(sign>>15)) :
-					(R==std::round_toward_zero) ? (sign|0x7BFF) :
-					(sign|0x7C00);
